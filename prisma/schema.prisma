generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  sale
  rent
}

enum UserRole {
  admin
  realtor
}

enum ListingStatus {
  pending
  approved
  rejected
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(realtor)
  active       Boolean  @default(true)
  properties   Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id         Int    @id @default(autoincrement())
  title      String
  address    String
  city       String
  province   String
  postalCode String

  listingType ListingType
  price       Int

  bedrooms     Int
  bathrooms    Float
  propertyType String
  yearBuilt    Int?

  description String

  realtorName      String
  realtorBrokerage String?

  status       ListingStatus @default(pending)
  reviewedAt   DateTime?
  reviewedById Int?

  // Legacy demo listings have no owner; only admins may update/delete them.
  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  images    PropertyImage[]
  panoramas Panorama[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model PropertyImage {
  id        Int    @id @default(autoincrement())
  url       String
  sortOrder Int    @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Panorama {
  id        Int    @id @default(autoincrement())
  name      String
  url       String
  sortOrder Int    @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}
