generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ViewingRequestStatus {
  new
  contacted
  closed
}

enum ListingType {
  sale
  rent
}

enum UserRole {
  admin
  realtor
}

enum RealtorApprovalStatus {
  pending
  approved
  rejected
}

enum ListingStatus {
  pending
  approved
  rejected
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(realtor)
  active       Boolean  @default(true)
  approvalStatus RealtorApprovalStatus @default(approved)
  fullName     String?
  brokerage    String?
  licenseNumber String?
  properties   Property[]

  @@index([role, approvalStatus])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id         Int    @id @default(autoincrement())
  title      String
  address    String
  city       String
  province   String
  postalCode String

  listingType ListingType
  price       Int

  bedrooms     Int
  bathrooms    Float
  propertyType String
  yearBuilt    Int?

  description String

  realtorName      String
  realtorBrokerage String?

  status       ListingStatus @default(pending)
  reviewedAt   DateTime?
  reviewedById Int?

  // Legacy demo listings have no owner; only admins may update/delete them.
  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  viewingRequests ViewingRequest[]
  metrics PropertyMetrics?

  images    PropertyImage[]
  panoramas Panorama[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model PropertyImage {
  id        Int    @id @default(autoincrement())
  url       String
  sortOrder Int    @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Panorama {
  id        Int    @id @default(autoincrement())
  name      String
  url       String
  sortOrder Int    @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model ViewingRequest {
  id Int @id @default(autoincrement())
  propertyId Int
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name String
  email String
  phone String
  preferredDate DateTime
  message String?
  status ViewingRequestStatus @default(new)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([propertyId, createdAt])
  @@index([status])
}

model PropertyMetrics {
  propertyId Int @id
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  views Int @default(0)
  tourStarts Int @default(0)
  updatedAt DateTime @updatedAt
}

enum BlogStatus {
  draft
  approved
  rejected
  published
}

model BlogPost {
  id               Int        @id @default(autoincrement())
  slug             String     @unique
  title            String
  excerpt          String
  category         String
  body             String     @db.Text
  status           BlogStatus @default(draft)
  revision         Int        @default(1)
  approvedRevision Int?
  createdById      Int
  approvedById     Int?
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  audit            BlogAudit[]

  @@index([status, publishedAt])
}

model BlogAudit {
  id         Int      @id @default(autoincrement())
  blogPostId Int
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  actorId    Int
  action     String
  revision   Int
  createdAt  DateTime @default(now())

  @@index([blogPostId, createdAt])
}
